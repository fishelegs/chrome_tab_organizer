{
  "manifest_version": 3,
  "name": "标签组助手",
  "version": "2.0.0",
  "description": "复制、置顶，并通过跨设备同步和两层文件夹管理标签组存档。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "tabGroups"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "标签组助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "duplicate-current-tab-group": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "复制当前标签页所在的标签组"
    }
  }
}
